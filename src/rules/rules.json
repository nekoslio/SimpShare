{
  "name": "SimpShare 站点规则订阅",
  "author": "SimpShare",
  "version": 6,
  "updatedAt": "2026-09-05",
  "description": "GKD 风格的声明式站点规则：与应用主体分离，可独立更新。匹配(match/matchAny)决定规则命中；extract 决定标题/简介/封面的提取（og 为所有命中规则的兜底）；transforms 做字段变换；card 传入卡片渲染器。render: true 表示站点为客户端渲染/强跳转页面，两端改用无头 WebView 加载、等链接完全重定向并渲染后再从 DOM 捕获元信息。",
  "behavior": {
    "ogForUnmatchedSites": true,
    "unmatchedCoverMeta": ["og:image", "og:image:secure_url", "twitter:image", "twitter:image:src", "itemprop:image"]
  },
  "metaTags": {
    "title": ["og:title", "twitter:title"],
    "description": ["og:description", "twitter:description", "description"],
    "image": ["og:image", "og:image:secure_url", "twitter:image", "twitter:image:src"]
  },
  "redirect": {
    "rules": [
      {
        "match": "^https?://(?:www\\.)?bilibili\\.com/video/(BV[\\w-]+)",
        "replace": "https://bilibilibb.com/video/$1",
        "unmatch": "^https?://(?:www\\.)?bilibilibb\\.com/video/(BV[\\w-]+)",
        "unreplace": "https://bilibili.com/video/$1"
      },
      {
        "match": "^https?://b23\\.tv/([\\w-]+)",
        "replace": "https://b23bb.tv/$1",
        "unmatch": "^https?://b23bb\\.tv/([\\w-]+)",
        "unreplace": "https://b23.tv/$1"
      }
    ]
  },
  "siteRules": [
    {
      "id": "bilibili-video",
      "label": "哔哩哔哩视频",
      "matchAny": [
        { "hosts": ["bilibili.com"], "path": "/video/" },
        { "hosts": ["b23.tv"] }
      ],
      "extract": {
        "og": true,
        "state": {
          "source": "__INITIAL_STATE__",
          "requirePath": "videoData.title",
          "fields": {
            "title": "{videoData.title}",
            "cover": "{videoData.pic}",
            "descLines": ["UP主：{videoData.owner.name}", "{videoData.desc}"]
          }
        }
      },
      "transforms": [{ "field": "cover", "forceHttps": true }]
    },
    {
      "id": "netease-music",
      "label": "网易云音乐",
      "match": {
        "hosts": ["music.163.com"],
        "path": "/(song|album|playlist)",
        "pathSource": "pathAndHash"
      },
      "extract": {
        "og": true,
        "api": {
          "pathSource": "pathAndHash",
          "idFrom": { "type": "queryOrHash", "name": "id" },
          "branches": [
            {
              "whenPath": "/song",
              "url": "https://music.163.com/api/song/detail/?id={id}&ids=%5B{id}%5D",
              "requirePath": "songs.0.name",
              "fields": {
                "title": "{songs.0.name}",
                "cover": "{songs.0.album.picUrl}",
                "descLines": ["歌手：{songs.0.artists[*].name|join ' / '}", "专辑：《{songs.0.album.name}》"]
              }
            },
            {
              "whenPath": "/album",
              "url": "https://music.163.com/api/album/{id}",
              "requirePath": "product.name",
              "fields": {
                "title": "{product.name|fallback name}",
                "cover": "{product.picUrl|fallback picUrl}",
                "descLines": ["歌手：{product.artists[*].name|fallback artists[*].name|join ' / '}"]
              }
            },
            {
              "whenPath": "/playlist",
              "url": "https://music.163.com/api/playlist/detail?id={id}",
              "requirePath": "result.name",
              "fields": {
                "title": "{result.name}",
                "cover": "{result.coverImgUrl}",
                "descLines": ["创建者：{result.creator.nickname}", "共 {result.trackCount} 首", "{result.description|clip 160}"]
              }
            }
          ]
        }
      },
      "transforms": [{ "field": "cover", "appendQuery": "param=1000y1000" }]
    },
    {
      "id": "github",
      "label": "GitHub 项目页",
      "note": "官方社交卡片自带简介文字：封面不裁切、卡片不重复绘制简介",
      "match": {
        "hosts": ["github.com"],
        "path": "^/[^/]+/[^/]+/?$",
        "pathExclude": "^/(orgs|topics|marketplace|settings|notifications|explore|trending|features|pricing|sponsors|collections|security|enterprise|about|contact|login|join|search|searches|dashboard|account|site|events|issues|pulls|codespaces|apps|install|new|organizations|team|customers|readme|stats|git|showcases)/"
      },
      "card": { "containCover": true, "hideDesc": true },
      "extract": { "og": true },
      "coverFallback": { "pattern": "^/([^/]+)/([^/]+)", "template": "https://opengraph.githubassets.com/1/{1}/{2}" },
      "titleFromPath": { "pattern": "^/([^/]+)/([^/]+)", "template": "{1}/{2}" },
      "transforms": [{ "field": "description", "stripRegex": "\\s*Contribute to .*? on GitHub\\.?\\s*$", "flags": "i" }]
    },
    {
      "id": "youtube",
      "label": "YouTube 视频",
      "matchAny": [
        { "hosts": ["youtube.com", "youtube-nocookie.com"], "path": "/(watch|shorts/)" },
        { "hosts": ["youtu.be"], "path": "/.+" }
      ],
      "extract": {
        "og": true,
        "state": {
          "source": "ytInitialPlayerResponse",
          "requirePath": "videoDetails.title",
          "fields": {
            "title": "{videoDetails.title}",
            "cover": "{videoDetails.thumbnail.thumbnails[-1].url}",
            "descLines": ["{videoDetails.author}", "{videoDetails.shortDescription}"]
          }
        }
      }
    },
    {
      "id": "bilibili-read",
      "label": "B站专栏",
      "note": "专栏页是纯客户端渲染的壳（无 og 无状态），走开放 API x/article/view；id 从 /read/cv{id} 或 /read/mobile?id=cv{id} 路径捕获",
      "matchAny": [
        { "hosts": ["bilibili.com"], "path": "/read/" }
      ],
      "extract": {
        "og": true,
        "api": {
          "idFrom": { "type": "path", "pattern": "/read/(?:cv|mobile\\?id=cv)?(\\d+)" },
          "branches": [
            {
              "url": "https://api.bilibili.com/x/article/view?id={id}",
              "requirePath": "data.title",
              "fields": {
                "title": "{data.title}",
                "cover": "{data.banner_url|fallback data.image_urls.0}",
                "descLines": ["UP主：{data.author.name}", "{data.summary|clip 160}"]
              }
            }
          ]
        }
      },
      "transforms": [{ "field": "cover", "forceHttps": true }]
    },
    {
      "id": "bilibili-opus",
      "label": "B站动态图文",
      "note": "opus 页内嵌 __INITIAL_STATE__.detail（SSR）；正文取 word 文本节点，封面取首个图片节点；标题去“ - 哔哩哔哩”后缀",
      "matchAny": [
        { "hosts": ["bilibili.com"], "path": "/opus/" }
      ],
      "extract": {
        "og": true,
        "state": {
          "source": "__INITIAL_STATE__",
          "requirePath": "detail.basic.title",
          "fields": {
            "title": "{detail.basic.title}",
            "cover": "{detail.modules[*].module_content.paragraphs[*].text.nodes[*].pic.url|first}",
            "descLines": [
              "UP主：{detail.modules[*].module_author.name|join ' / '}",
              "{detail.modules[*].module_content.paragraphs[*].text.nodes[*].word.words|join ''|clip 160}"
            ]
          }
        }
      },
      "transforms": [
        { "field": "title", "stripRegex": "\\s*-\\s*哔哩哔哩\\s*$" },
        { "field": "cover", "forceHttps": true }
      ]
    },
    {
      "id": "bilibili-other",
      "label": "B站直播/活动页",
      "matchAny": [
        { "hosts": ["bilibili.com"], "path": "/festival/" },
        { "hosts": ["live.bilibili.com"] }
      ],
      "extract": { "og": true }
    },
    {
      "id": "douyin",
      "label": "抖音视频",
      "match": { "hosts": ["douyin.com", "iesdouyin.com"], "path": "/(video|note)/" },
      "extract": { "og": true }
    },
    {
      "id": "tencent-video",
      "label": "腾讯视频",
      "match": { "hosts": ["v.qq.com"], "path": "/x/(cover|page)/" },
      "extract": { "og": true }
    },
    {
      "id": "iqiyi",
      "label": "爱奇艺",
      "match": { "hosts": ["iqiyi.com"], "path": "/v_" },
      "extract": { "og": true }
    },
    {
      "id": "youku",
      "label": "优酷",
      "matchAny": [
        { "hosts": ["youku.com"], "path": "^/(v_show|v_)" },
        { "hosts": ["youku.com"], "path": "^/video$", "query": { "vid": true } }
      ],
      "extract": { "og": true }
    },
    {
      "id": "vimeo",
      "label": "Vimeo",
      "match": { "hosts": ["vimeo.com"], "path": "/\\d+" },
      "extract": { "og": true }
    },
    {
      "id": "twitch",
      "label": "Twitch",
      "match": { "hosts": ["twitch.tv"], "path": "/(videos/|clip/)" },
      "extract": { "og": true }
    },
    {
      "id": "qq-music",
      "label": "QQ音乐",
      "match": { "hosts": ["y.qq.com"], "path": "/n/ryqq/(songDetail|albumDetail)" },
      "extract": { "og": true }
    },
    {
      "id": "kugou",
      "label": "酷狗音乐",
      "match": { "hosts": ["kugou.com", "kugou.cn"], "path": "/(song|mixsong)" },
      "extract": { "og": true }
    },
    {
      "id": "spotify",
      "label": "Spotify",
      "match": { "hosts": ["open.spotify.com"] },
      "extract": { "og": true }
    },
    {
      "id": "soundcloud",
      "label": "SoundCloud",
      "match": { "hosts": ["soundcloud.com"] },
      "extract": { "og": true }
    },
    {
      "id": "weixin",
      "label": "微信公众号文章",
      "match": { "hosts": ["mp.weixin.qq.com"], "path": "/s" },
      "extract": { "og": true }
    },
    {
      "id": "zhihu",
      "label": "知乎问答/专栏",
      "matchAny": [
        { "hosts": ["zhihu.com"], "path": "/(question|pin)/" },
        { "hosts": ["zhuanlan.zhihu.com"], "path": "/p/" }
      ],
      "extract": { "og": true }
    },
    {
      "id": "weibo",
      "label": "微博",
      "match": { "hosts": ["weibo.com", "m.weibo.cn"], "path": "/\\d+/|/status/" },
      "extract": { "og": true }
    },
    {
      "id": "xiaohongshu",
      "label": "小红书",
      "match": { "hosts": ["xiaohongshu.com"], "path": "/(explore/|discovery/item/)" },
      "extract": { "og": true }
    },
    {
      "id": "douban",
      "label": "豆瓣条目",
      "match": { "hosts": ["douban.com"], "path": "/subject/" },
      "extract": { "og": true }
    },
    {
      "id": "juejin",
      "label": "掘金",
      "match": { "hosts": ["juejin.cn"], "path": "/post/" },
      "extract": { "og": true }
    },
    {
      "id": "csdn",
      "label": "CSDN 博客",
      "match": { "hosts": ["csdn.net"], "path": "article/details/" },
      "extract": { "og": true }
    },
    {
      "id": "sspai",
      "label": "少数派",
      "match": { "hosts": ["sspai.com"], "path": "/post/" },
      "extract": { "og": true }
    },
    {
      "id": "jianshu",
      "label": "简书",
      "match": { "hosts": ["jianshu.com"], "path": "/p/" },
      "extract": { "og": true }
    },
    {
      "id": "stackoverflow",
      "label": "Stack Overflow",
      "match": { "hosts": ["stackoverflow.com"], "path": "/questions?/" },
      "extract": { "og": true }
    },
    {
      "id": "segmentfault",
      "label": "思否 SegmentFault",
      "match": { "hosts": ["segmentfault.com"], "path": "/(a|p)/" },
      "extract": { "og": true }
    },
    {
      "id": "v2ex",
      "label": "V2EX",
      "match": { "hosts": ["v2ex.com"], "path": "/t/" },
      "extract": { "og": true }
    },
    {
      "id": "gitlab",
      "label": "GitLab 项目页",
      "match": { "hosts": ["gitlab.com"], "path": "^/[^/]+/[^/]+/?$" },
      "extract": { "og": true }
    },
    {
      "id": "npm",
      "label": "npm 包",
      "match": { "hosts": ["npmjs.com"], "path": "/package/" },
      "extract": { "og": true }
    },
    {
      "id": "pypi",
      "label": "PyPI 包",
      "match": { "hosts": ["pypi.org"], "path": "/project/" },
      "extract": { "og": true }
    },
    {
      "id": "arxiv",
      "label": "arXiv 论文",
      "match": { "hosts": ["arxiv.org"], "path": "/abs/" },
      "extract": { "og": true }
    },
    {
      "id": "steam",
      "label": "Steam 商店页",
      "match": { "hosts": ["steampowered.com"], "path": "/app/" },
      "extract": { "og": true }
    },
    {
      "id": "miui-community",
      "label": "小米社区帖子",
      "note": "SPA 无 SSR 数据；render: true 走无头 WebView，等页面渲染完成取 document.title（即帖子标题）；coverFromDom 抓不到 og 封面时取正文第一张大图",
      "match": { "hosts": ["vip.miui.com"], "path": "/page/info/mio/" },
      "render": { "minMs": 2500, "coverFromDom": true },
      "extract": { "og": true }
    },
    {
      "id": "wikipedia",
      "label": "维基百科",
      "note": "zh 系页面 og 无简介；走 REST summary API（{host} 取当前子域）拿干净的标题、首段简介与配图，失败退回 og",
      "matchAny": [
        { "hosts": ["wikipedia.org"], "path": "/wiki/" },
        { "hosts": ["wikimedia.org"], "path": "/wiki/" }
      ],
      "extract": {
        "og": true,
        "api": {
          "idFrom": { "type": "path", "pattern": "/wiki/(.+)" },
          "branches": [
            {
              "url": "https://{host}/api/rest_v1/page/summary/{id}",
              "requirePath": "extract",
              "fields": {
                "title": "{title}",
                "cover": "{originalimage.source|fallback thumbnail.source}",
                "descLines": ["{extract|clip 160}"]
              }
            }
          ]
        }
      }
    },
    {
      "id": "coolapk",
      "label": "酷安动态",
      "note": "网页端对无追踪参数的链接只渲染扫码落地页；从酷安 App 分享出的链接带 ?s=shareToken，服务端会渲染完整页面（真实标题 + 帖子首图）。coverFromHtml 从 HTML 里抠帖子首图当封面，裸链接降级二维码模式；shareHint 表示 Android 端可用分享文本里的【标题】兜底",
      "match": { "hosts": ["coolapk.com"], "path": "/feed/" },
      "shareHint": true,
      "extract": { "og": true },
      "coverFromHtml": { "pattern": "image\\.coolapk\\.com/feed/[^\"]+?\\.(?:jpg|jpeg|png|webp)" },
      "transforms": [{ "field": "cover", "forceHttps": true }]
    },
    {
      "id": "goofish",
      "label": "闲鱼商品",
      "note": "p.goofish.com 短链经 HTTP 302 落到 h5 端再 JS 跳转 www 端；render: true 让无头 WebView 等待整条重定向链稳定后再捕获。商品详情接口有登录/风控门禁：登录态下标题即商品名、coverFromDom 取商品首图，未登录降级二维码模式；shareHint 表示 Android 端可用分享文本里的【标题】兜底",
      "matchAny": [
        { "hosts": ["goofish.com"], "path": "/item" },
        { "hosts": ["goofish.com"], "path": "/p/" }
      ],
      "render": { "coverFromDom": true },
      "shareHint": true,
      "extract": { "og": true },
      "transforms": [
        { "field": "title", "stripRegex": "_闲鱼\\s*$" },
        { "field": "description", "stripRegex": "^闲鱼，中国领先的闲置二手交易平台[\\s\\S]*$" }
      ]
    },
    {
      "id": "baidu-pan",
      "label": "百度网盘分享",
      "note": "带 pwd 的链接在页面内自动验证后跳转文件列表页，标题即“{文件名}_免费高速下载|…”；render.minMs 确保无头捕获等到验证跳转完成而不是停在提取码页",
      "match": { "hosts": ["pan.baidu.com"], "path": "/s/" },
      "render": { "minMs": 9000 },
      "extract": { "og": true },
      "transforms": [
        { "field": "title", "stripRegex": "_免费高速下载[\\s\\S]*$" },
        { "field": "description", "stripRegex": "^百度网盘为您提供[\\s\\S]*$" }
      ]
    },
    {
      "id": "duckduckgo",
      "label": "DuckDuckGo 搜索",
      "note": "搜索结果页无 og；标题从 q 参数组装",
      "match": { "hosts": ["duckduckgo.com"], "query": { "q": true } },
      "extract": { "og": true },
      "titleFromQuery": { "name": "q", "template": "{q} - DuckDuckGo 搜索" }
    },
    {
      "id": "123pan",
      "label": "123云盘分享",
      "note": "标题服务端直出“{文件名} - 123云盘…”；render 等列表渲染完成再捕获，站点样板简介与标题后缀由 transforms 清除",
      "matchAny": [
        { "hosts": ["123pan.cn", "123pan.com"], "path": "/(s|123pan)/" }
      ],
      "render": { "minMs": 2500 },
      "extract": { "og": true },
      "transforms": [
        { "field": "title", "stripRegex": "\\s*-\\s*123云盘[\\s\\S]*$" },
        { "field": "description", "stripRegex": "^123云盘为您提供[\\s\\S]*$" }
      ]
    }
  ]
}
